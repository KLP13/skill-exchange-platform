# ────────────────────────────────────────────
#  SkillSwap Backend — Environment Variables
#  EXAMPLE FILE — copy to .env and fill in your real values.
#  Never commit the real .env file to version control.
# ────────────────────────────────────────────

# Express server port
PORT=5000

# Frontend origin allowed by CORS (Vite dev server)
FRONTEND_URL=http://localhost:5173

# PostgreSQL connection details
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgresql_password
DB_NAME=skillswap

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Email SMTP Settings (Nodemailer)
# For Gmail SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_16_digit_app_password
# EMAIL_FROM="SkillSwap VIT" <noreply@skillswap.vit.ac.in>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SkillSwap VIT" <noreply@skillswap.vit.ac.in>
